<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:allowBackup="false" android:icon="@drawable/ic_taoconnect"
        android:label="@string/app_name" android:roundIcon="@drawable/ic_taoconnect"
        android:supportsRtl="true" android:theme="@style/Theme.TaoConnect"
        android:usesCleartextTraffic="false">
        <activity android:name=".TaobaoBrowserActivity" android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".TaoConnectTileService" android:exported="true"
            android:icon="@drawable/ic_tile" android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
