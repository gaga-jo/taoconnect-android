<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browserRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:gravity="center_vertical" android:paddingHorizontal="8dp" android:orientation="horizontal">
        <Button android:id="@+id/browserBack" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:text="‹"
            android:contentDescription="@string/browser_back" android:textSize="28sp" android:padding="0dp"
            android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:textColor="#172A27" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tao Connect" android:textStyle="bold" android:textSize="17sp" android:textColor="#172A27" />
            <TextView android:id="@+id/browserDomain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="taobao.com" android:textSize="11sp"
                android:singleLine="true" android:ellipsize="end" android:textColor="#66716A" />
        </LinearLayout>
        <Button android:id="@+id/bilingualToggle" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="72dp" android:layout_height="48dp" android:text="中 + FR"
            android:textSize="13sp" android:padding="0dp" android:textColor="#176653"
            android:contentDescription="@string/toggle_bilingual" />
        <Button android:id="@+id/browserMenu" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="48dp" android:layout_height="48dp" android:text="⋮" android:textSize="24sp"
            android:padding="0dp" android:minWidth="0dp" android:contentDescription="@string/browser_menu" />
    </LinearLayout>
    <TextView android:id="@+id/browserStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="28dp" android:paddingHorizontal="16dp"
        android:paddingVertical="5dp" android:background="#F1F6F3" android:textColor="#386552"
        android:textSize="11sp" android:text="@string/bilingual_active" />
    <ProgressBar android:id="@+id/pageProgress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="false" />
    <WebView android:id="@+id/taobaoWebView" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
