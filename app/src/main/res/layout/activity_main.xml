<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/welcomeRoot" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:background="#FAFAF8">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="44dp" android:text="TAO CONNECT"
            android:letterSpacing="0.16" android:textSize="13sp" android:textStyle="bold"
            android:textColor="#B9431B" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="@string/bilingual_headline"
            android:textSize="34sp" android:textStyle="bold" android:textColor="#172A27" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/bilingual_intro"
            android:textSize="16sp" android:lineSpacingExtra="5dp" android:textColor="#53645E" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:padding="20dp" android:orientation="vertical"
            android:background="@drawable/bg_privacy">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="商品详情" android:textColor="#263C34" android:textSize="23sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Détails du produit"
                android:textColor="#176653" android:textSize="17sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="@string/bilingual_example"
                android:textColor="#53645E" android:textSize="12sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openBilingualButton" android:layout_width="match_parent"
            android:layout_height="60dp" android:layout_marginTop="28dp"
            android:text="@string/open_bilingual" android:textAllCaps="false"
            android:textSize="16sp" android:textColor="#FFFFFF"
            app:backgroundTint="#176653" app:cornerRadius="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/bilingual_scope"
            android:textColor="#53645E" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/bilingual_limits"
            android:textColor="#62716B" android:textSize="12sp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
